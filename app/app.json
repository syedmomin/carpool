{
  "expo": {
    "name": "ChalParo",
    "slug": "chalparo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/light-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b4b"
    },
    "notification": {
      "icon": "./assets/favicon.png",
      "color": "#0d1b4b"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0d1b4b",
        "foregroundImage": "./assets/dark-logo.png"
      },
      "package": "com.chalparo.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSPhotoLibraryUsageDescription": "ChalParo needs access to your photo library so you can upload vehicle and profile photos.",
        "NSCameraUsageDescription": "ChalParo needs access to your camera so you can take vehicle and profile photos."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ChalParo needs access to your photo library so you can upload vehicle and profile photos.",
          "cameraPermission": "ChalParo needs access to your camera so you can take vehicle and profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChalParo uses your location to share your live trip with passengers while a ride is in progress.",
          "locationAlwaysAndWhenInUsePermission": "ChalParo shares your live trip location with passengers even when the app is in the background, so they can track the ride until it ends.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "f6b04991-d10f-4b46-b647-0fb51d98f0dd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6b04991-d10f-4b46-b647-0fb51d98f0dd"
    }
  }
}
